# Coffee-with-Cinema Environment Configuration
# Copy this file to .env and update with your values

# Flask Configuration
SECRET_KEY=coffee-cinema-secret-key-change-in-production-2026
DEBUG=True

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=granite3.2:8b
OLLAMA_TIMEOUT=120

# Database Configuration
DATABASE_URL=sqlite:///coffee_cinema.db

# Session Configuration
SESSION_COOKIE_SECURE=False
SESSION_LIFETIME_HOURS=2

# Feature Flags
ENABLE_TONE_ANALYSIS=True
ENABLE_COSTUME_DETAILS=True
ENABLE_CHARACTER_ARC_SEPARATION=True
ENABLE_CONSISTENCY_TRACKING=True
ENABLE_TEMPLATE_LIBRARY=True

# Generation Parameters
SCREENPLAY_MAX_TOKENS=3500
CHARACTER_MAX_TOKENS=2500
SOUND_MAX_TOKENS=2500
TONE_MAX_TOKENS=800
COSTUME_MAX_TOKENS=1500
CHARACTER_ARC_MAX_TOKENS=2000

# Temperature Settings
TEMPERATURE_CREATIVE=0.7
TEMPERATURE_ANALYTICAL=0.4

# File Upload & Export
MAX_CONTENT_LENGTH=16777216
ALLOWED_EXPORT_FORMATS=txt,pdf,docx

# Logging
LOG_LEVEL=INFO
